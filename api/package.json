{
  "name": "swiftremit-api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:chaos": "vitest run --config vitest.chaos.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:pact": "vitest run src/__tests__/pact",
    "lint": "eslint src --ext .ts",
    "generate:openapi": "tsx generate-openapi.ts",
    "validate:openapi": "swagger-cli validate openapi.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@pact-foundation/pact": "^13.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "pg-mem": "^3.0.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
