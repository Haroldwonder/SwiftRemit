# API Configuration
# In production, secrets should be sourced from AWS Secrets Manager
SECRETS_MANAGER_ENABLED=false  # Set to true in production
AWS_REGION=us-east-1

# Required secrets (in production, inject via AWS Secrets Manager):
#   - swiftremit/DATABASE_URL
#   - swiftremit/JWT_SECRET
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swiftremit

# Database SSL/TLS (Security hardening — issue #1564)
# Require SSL/TLS for database connections in production. Local development
# keeps working without mandatory SSL (defaults to false).
# Set DATABASE_SSL=true in production so connections are encrypted in transit.
DATABASE_SSL=false
# Optional: path to a CA certificate for verifying the database server cert.
# Leave empty to use the system trust store.
DATABASE_SSL_CA=
# Optional: set to true to reject unauthorized certs (recommended in production).
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# CORS Allowlist
# Comma-separated list of exact origins allowed to call this API cross-origin
# (e.g. the SwiftRemit frontend). Origins not on this list are rejected;
# credentials (cookies) are only sent for allowlisted origins — required for
# the cookie-based /api/auth/refresh flow (see AUTH_MATRIX.md).
ALLOWED_ORIGINS=https://app.swiftremit.io,http://localhost:5173
CONTRACT_RPC_URL=

# Admin API key for anchor operations.
# SECURITY: This is a placeholder only. Do NOT deploy to production with this
# value. Generate a strong, unique secret (e.g. `openssl rand -hex 32`) and
# inject it via AWS Secrets Manager (swiftremit/ANCHORS_ADMIN_API_KEY) before
# going to production. See the Security Checklist in SETUP_GUIDE.md.
ANCHORS_ADMIN_API_KEY=replace-with-a-strong-random-secret

# Rate Limiting
# Enabled by default; set RATE_LIMIT_ENABLED=false only for local debugging.
RATE_LIMIT_ENABLED=true
# Sliding window length in milliseconds (900000 = 15 minutes).
RATE_LIMIT_WINDOW_MS=900000
# Max requests allowed per client IP within the window.
RATE_LIMIT_MAX_REQUESTS=100
# Stricter limit applied to sensitive auth endpoints (login/register/refresh).
RATE_LIMIT_AUTH_MAX_REQUESTS=10
# Trust X-Forwarded-For from the reverse proxy so limits key on the real client IP.
RATE_LIMIT_TRUST_PROXY=true

# Currency Configuration
CURRENCY_CONFIG_PATH=./config/currencies.json
CURRENCY_CONFIG_ENV_OVERRIDE=false

# Environment-specific currency overrides (JSON format)
# Example: CURRENCY_OVERRIDES='[{"code":"USD","symbol":"$","decimal_precision":2}]'
CURRENCY_OVERRIDES=

# ── Audit Logging (SR-1568) ──────────────────────────────────────────────────
# Enable structured audit logging for admin and security-sensitive operations
# (auth, key/role changes, config mutations). Records include actor, action,
# target, timestamp, and outcome. Keep enabled in production.
AUDIT_LOG_ENABLED=true
# Destination for audit records: stdout | file
AUDIT_LOG_DESTINATION=stdout
# File path used when AUDIT_LOG_DESTINATION=file
AUDIT_LOG_FILE_PATH=./logs/audit.log
# Minimum severity to emit: info | warn | error
AUDIT_LOG_LEVEL=info
# Redact sensitive fields (tokens, secrets, passwords) from audit records.
AUDIT_LOG_REDACT_SENSITIVE=true

# ── OpenTelemetry / Distributed Tracing (SR-108) ─────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=swiftremit-api
# Sampler: always_on | always_off | traceidratio | parentbased_traceidratio
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# 0.1 = 10% in production; set to 1.0 for full sampling in development
OTEL_TRACES_SAMPLER_ARG=0.1

# ── Firewall / Network Hardening (Security Checklist) ────────────────────────
# Restrict inbound access to backend and database ports in production so they
# are not publicly reachable. Only the reverse proxy / load balancer should be
# exposed to the internet; the API and Postgres must stay on the private network.
#
# Bind the API to the private interface (or 127.0.0.1 behind a local proxy)
# instead of 0.0.0.0 so it is not directly reachable from the public internet.
HOST=127.0.0.1
#
# Inbound rules to apply at the cloud firewall / security group level:
#   - Allow 443/tcp (HTTPS) from 0.0.0.0/0 to the load balancer only
#   - Allow 80/tcp  (HTTP)  from 0.0.0.0/0 to the load balancer only (redirect to 443)
#   - Allow the API port (PORT, default 3000) ONLY from the load balancer / app subnet
#   - Allow Postgres (5432/tcp) ONLY from the API security group / private subnet
#   - Deny all other inbound traffic by default
#
# Example (AWS security groups):
#   api-sg:  ingress 3000/tcp from lb-sg
#   db-sg:   ingress 5432/tcp from api-sg
#   lb-sg:   ingress 443/tcp from 0.0.0.0/0
#
# Example (ufw on a single host):
#   ufw default deny incoming
#   ufw allow 443/tcp
#   ufw allow from <lb-cidr> to any port 3000 proto tcp
#   ufw allow from <api-cidr> to any port 5432 proto tcp
#   ufw enable
#
# See the Security Checklist in SETUP_GUIDE.md for the full production checklist.
