{
  "name": "swiftremit-mobile",
  "version": "1.0.0",
  "description": "SwiftRemit mobile app for senders (iOS & Android)",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint src App.tsx --ext .ts,.tsx",
    "lint:fix": "eslint src App.tsx --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:pact": "vitest run src/pact",
    "bundle:size": "npx expo export --platform web --output-dir /tmp/expo-bundle-check && du -sh /tmp/expo-bundle-check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.18.8",
    "axios": "^1.8.2",
    "expo": "~53.0.0",
    "expo-build-properties": "~0.14.5",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.3",
    "expo-crypto": "~14.1.3",
    "expo-device": "~7.1.3",
    "expo-font": "~13.2.2",
    "expo-image-picker": "~16.1.3",
    "expo-local-authentication": "~16.0.3",
    "expo-notifications": "~0.31.0",
    "expo-router": "~5.0.2",
    "expo-secure-store": "~14.2.2",
    "expo-splash-screen": "~0.30.6",
    "expo-status-bar": "~2.2.2",
    "react": "19.0.0",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "5.9.0",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.1",
    "typescript": "~5.8.3"
  }
}
