exports[`TransactionHistory snapshots > renders empty state when no transactions 1`] = `
<div>
  <section
    aria-label="Transaction history"
    class="transaction-history"
  >
    <header
      class="transaction-history-header"
    >
      <h2>
        Transaction History
      </h2>
      <div
        aria-label="History view mode"
        class="history-view-controls"
        role="tablist"
      >
        <button
          aria-selected="true"
          class="active"
          role="tab"
          type="button"
        >
          Table
        </button>
        <button
          aria-selected="false"
          class=""
          role="tab"
          type="button"
        >
          Cards
        </button>
      </div>
    </header>
    <p
      class="history-empty"
    >
      No transactions yet.
    </p>
  </section>
</div>
`;

